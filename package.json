{
  "name": "probay-premium",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api \"vite --host 127.0.0.1\" \"node --watch server/index.js\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "node --watch server/index.js",
    "build": "vite build && vite build --ssr client/src/entry-server.jsx --outDir build-ssr && node scripts/prerender.mjs",
    "start": "node server/index.js",
    "test": "node --test server/*.test.js tests/*.test.js",
    "check:content": "python scripts/migrate_content.py --check",
    "db:start": "node scripts/start-mongo.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "gsap": "^3.13.0",
    "helmet": "^8.1.0",
    "lenis": "^1.3.0",
    "lucide-react": "^0.468.0",
    "mongoose": "^8.19.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "sharp": "^0.35.5",
    "vite": "^7.1.0"
  }
}
